# Copy this file to `.env` (and `.env.production` for real deployments).

# In development you can leave this empty: Vite proxies /api to
# http://localhost:5000 (see vite.config.ts).
VITE_API_BASE_URL=

# On Vercel set this to your deployed backend, for example:
# VITE_API_BASE_URL=https://task-manager-api.onrender.com/api