# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to git.

# Port the API listens on
PORT=5000

# Set to "production" on Render (it sets NODE_ENV automatically)
NODE_ENV=development

# PostgreSQL connection string.
# Local example:
#   postgresql://postgres:postgres@localhost:5432/task_manager
# Render example: use the "Internal Database URL" from the Render dashboard.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_manager

# Secret used to sign login tokens. Anyone who knows it can forge a login,
# so use a long random value in production and never commit the real one.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
